# ---------------------------------------------------------------------------
# Ken: environment variables
#   Copy this file to .env and fill in what you use. .env is git-ignored: never commit keys.
#   Without any key you can still run the tests (python -m pytest) and the examples/ (offline).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# OpenAI (the default brain, speech-to-text and style-memory embeddings)
#   https://platform.openai.com/api-keys
#   Leave it empty and set ASSISTANT_BACKEND=local to keep everything on your machine (Ollama).
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# YouTube Data API v3 (optional)
#   Lets "Ken, play <video>" open the top result directly. Without it Ken opens the results page.
#   Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
# ASSISTANT_BACKEND=openai              # openai | local
# OLLAMA_HOST=http://127.0.0.1:11434    # where Ollama listens, for the local backend
